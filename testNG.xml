<!DOCTYPE suite SYSTEM "https://raw.githubusercontent.com/cbeust/testng/master/src/main/resources/testng-1.0.dtd" >
<suite name="University API Suite">
    <listeners>
        <listener class-name="com.example.university.listeners.ExtentReportListener" />
    </listeners>
    <test name="API Tests" preserve-order="true">
        <classes>
            <class name="com.example.university.tests.UniversityHappyPathTest" />
            <class name="com.example.university.tests.UniversityNegativeTest" />
        </classes>
    </test>
</suite>